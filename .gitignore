.vscode/
.idea/
.claude/
.cursor/
.windsurf/
.vscode-test/
.vscode-remote/
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project
.history/
.jsfiddle
.cache/
.mongo/

