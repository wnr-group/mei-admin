# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ============================================================================
# Node.js & Package Managers
# ============================================================================
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
package-lock.json
yarn.lock

# ============================================================================
# Build & Generated Files
# ============================================================================
/.next/
/out/
/build/
/dist/
*.tsbuildinfo
next-env.d.ts
*.egg-info
*.pyc
__pycache__/

# ============================================================================
# Testing & Coverage
# ============================================================================
/coverage/
.nyc_output/
*.lcov
.vitest-cache/

# ============================================================================
# Local Run Logs & Test Reports (Never commit these)
# ============================================================================
/build-output.txt
/final-lint.txt
/lint-before.txt
/lint-full.txt
/lint-output.txt
/test-output.log
/tests-before.txt
npm-debug.log*
npm-error.log*
yarn-debug.log*
yarn-error.log*
yarn-install-state.gz
.pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
pids/
*.seed
*.pid.lock
logs/
*.log

# ============================================================================
# Environment Variables & Secrets (Never commit sensitive data)
# ============================================================================
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
.env.vault
.envrc
.dirlocals
!.env.example
!.env.*.example
*.key
*.pem
*.crt
*.cer
.aws/
.netrc
.ssh/
credentials.json
secrets.json

# ============================================================================
# Supabase CLI Local Configuration
# ============================================================================
supabase/.temp/
supabase/.branches/

